# --- Go build artifacts ---
/bin/
*.exe
*.test
*.out
coverage.txt
coverage.html
profile.cov

# --- Frontend build artifacts ---
# web/dist is generated by `make build-frontend` and embedded into the
# binary at compile time. Only the placeholder web/dist/.gitkeep is tracked
# so that `go build ./...` works on a clean checkout. Never commit it.
/web/dist/*
!/web/dist/.gitkeep

node_modules/
web/node_modules/
.pnpm-store/
web/.vite/
web/.turbo/
*.tsbuildinfo

# --- Runtime data (never commit) ---
# The default data directory is ~/.li/liproxy; these patterns catch the case
# where someone points database.path at a repo-local file during development.
*.db
*.db-shm
*.db-wal
*.db-journal
*.sqlite
*.sqlite3
.li/
backups/
logs/
*.log
*.log.gz

# --- Secrets ---
.env
.env.*
!.env.example
*.pem
*.key
*.crt
!web/src/**/*.pem

# --- Editor / OS noise ---
.idea/
.vscode/
!.vscode/extensions.json
*.swp
*.swo
.DS_Store
Thumbs.db

# --- Tool caches ---
.golangci-lint-cache/
.cache/
tmp/

# Generic build dirs, but never web/dist: it is matched by the explicit
# /web/dist/* rule above and we must keep the .gitkeep placeholder tracked.
dist/
!web/dist/
