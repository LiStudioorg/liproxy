# --- Go build artifacts ---
/bin/
*.exe
*.test
*.out
coverage.txt
coverage.html
profile.cov

# --- Frontend build artifacts ---
# The frontend tree (web/) is created in the frontend phase; these patterns
# are placeholders for the pnpm workspace it will contain.
node_modules/
web/node_modules/
.pnpm-store/
web/.vite/
web/.turbo/
*.tsbuildinfo

# --- Runtime data (never commit) ---
# The default data directory is ~/.li/liproxy; these patterns catch the case
# where someone points database.path at a repo-local file during development.
*.db
*.db-shm
*.db-wal
*.db-journal
*.sqlite
*.sqlite3
.li/
backups/
logs/
*.log
*.log.gz

# --- Secrets ---
.env
.env.*
!.env.example
*.pem
*.key
*.crt

# --- Editor / OS noise ---
.idea/
.vscode/
!.vscode/extensions.json
*.swp
*.swo
.DS_Store
Thumbs.db

# --- Tool caches ---
.golangci-lint-cache/
.cache/
tmp/

# Generic build dirs. The frontend's own dist/ is covered when web/ lands,
# by an explicit rule alongside the placeholder it must keep tracked.
dist/
